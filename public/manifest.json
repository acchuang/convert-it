{
  "name": "CONVERT \u2014 Universal File Converter",
  "short_name": "CONVERT",
  "description": "Convert any file to any format, entirely in your browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "orientation": "any",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["utilities", "productivity"],
  "id": "/",
  "scope": "/",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "video/3gpp",
            "audio/aac",
            "video/x-msvideo",
            "image/avif",
            "image/bmp",
            "text/csv",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "audio/flac",
            "video/x-flv",
            "image/gif",
            "image/heic",
            "text/html",
            "image/x-icon",
            "image/jpeg",
            "application/json",
            "image/jxl",
            "audio/mp4",
            "video/mp4",
            "text/markdown",
            "video/x-matroska",
            "video/quicktime",
            "audio/mpeg",
            "audio/ogg",
            "audio/opus",
            "application/pdf",
            "image/png",
            "application/x-subrip",
            "image/svg+xml",
            "text/tab-separated-values",
            "text/plain",
            "text/vtt",
            "audio/wav",
            "video/webm",
            "image/webp",
            "audio/x-ms-wma",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/xml",
            "application/yaml",
            ".3gp",
            ".aac",
            ".avi",
            ".avif",
            ".bmp",
            ".csv",
            ".docx",
            ".flac",
            ".flv",
            ".gif",
            ".heic",
            ".html",
            ".ico",
            ".jpeg",
            ".jpg",
            ".json",
            ".jxl",
            ".m4a",
            ".m4v",
            ".mp4",
            ".md",
            ".mkv",
            ".mov",
            ".mp3",
            ".ogg",
            ".opus",
            ".pdf",
            ".png",
            ".srt",
            ".svg",
            ".tsv",
            ".txt",
            ".vtt",
            ".wav",
            ".webm",
            ".webp",
            ".wma",
            ".xlsx",
            ".xml",
            ".yaml"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "video/3gpp": [".3gp"],
        "audio/aac": [".aac"],
        "video/x-msvideo": [".avi"],
        "image/avif": [".avif"],
        "image/bmp": [".bmp"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "audio/flac": [".flac"],
        "video/x-flv": [".flv"],
        "image/gif": [".gif"],
        "image/heic": [".heic"],
        "text/html": [".html"],
        "image/x-icon": [".ico"],
        "image/jpeg": [".jpeg", ".jpg"],
        "application/json": [".json"],
        "image/jxl": [".jxl"],
        "audio/mp4": [".m4a"],
        "video/mp4": [".m4v", ".mp4"],
        "text/markdown": [".md"],
        "video/x-matroska": [".mkv"],
        "video/quicktime": [".mov"],
        "audio/mpeg": [".mp3"],
        "audio/ogg": [".ogg"],
        "audio/opus": [".opus"],
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "application/x-subrip": [".srt"],
        "image/svg+xml": [".svg"],
        "text/tab-separated-values": [".tsv"],
        "text/plain": [".txt"],
        "text/vtt": [".vtt"],
        "audio/wav": [".wav"],
        "video/webm": [".webm"],
        "image/webp": [".webp"],
        "audio/x-ms-wma": [".wma"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/xml": [".xml"],
        "application/yaml": [".yaml"]
      },
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
