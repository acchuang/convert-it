# Base URL for the self-hosted FFmpeg core (ffmpeg-core.js + ffmpeg-core.wasm,
# from @ffmpeg/core@0.12.10/dist/umd). Required — video and audio conversion
# throws without it. Use an R2 custom domain, not the rate-limited *.r2.dev URL,
# and allow this app's origin in the bucket's CORS policy (see r2-cors.json).
NEXT_PUBLIC_FFMPEG_BASE_URL=https://cdn.oilygold.xyz/ffmpeg-core/0.12.10
